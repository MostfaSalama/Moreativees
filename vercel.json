{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/archive", "destination": "/portfolio", "permanent": true },
    { "source": "/archive.html", "destination": "/portfolio", "permanent": true }
  ],
  "rewrites": [
    { "source": "/portfolio/:cat/:proj", "destination": "/portfolio" },
    { "source": "/portfolio/:cat", "destination": "/portfolio" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/portfolio",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/portfolio/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/archive",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/preview-studio",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/ITSMEmostfa1426",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/ITSMEmostfa1426.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/assets/studio-ui/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
